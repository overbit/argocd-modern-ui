{
  "manifest_version": 3,
  "name": "Argo CD Modern UI",
  "version": "0.7.0",
  "description": "Diagram-first Argo CD UI with direct controls, workload logs, WebSocket terminal, structured JSON, dark theme, and safe UI escape modes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Argo CD Modern UI"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}